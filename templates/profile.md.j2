} -%}
{%- set project_groups = [
  {id: "openapi", title: "API engineering & OpenAPI", topic: "portfolio-openapi", projects: []},
  {id: "agents", title: "Agents & AI tools", topic: "portfolio-agents", projects: []},
  {id: "plex", title: "Plex ecosystem", topic: "portfolio-plex", projects: []},
  {id: "sdks", title: "Service SDKs & integrations", topic: "portfolio-sdks", projects: []},
  {id: "web", title: "Web & app foundations", topic: "portfolio-web", projects: []},
  {id: "developer-tools", title: "Developer tools & automation", topic: "portfolio-developer-tools", projects: []},
  {id: "homelab", title: "Self-hosting & homelab", topic: "portfolio-homelab", projects: []},
  {id: "devices", title: "Devices & interoperability", topic: "portfolio-devices", projects: []},
  {id: "identity", title: "Identity & SailPoint", topic: "portfolio-identity", projects: []},
  {id: "research", title: "Research, datasets & references", topic: "portfolio-research", projects: []}
] -%}
{%- set catalog = [] -%}
{%- set invalid_topics = [] -%}
{%- set candidates = project_snapshot.repositories | rejectattr("isPrivate") | rejectattr("isFork") | rejectattr("isArchived") -%}
{%- for repo in candidates -%}
  {%- set name = repo.name | lower -%}
  {%- set description = (repo.description or "") | trim -%}
  {%- if not description -%}{%- set description = description_overrides[name] or "" -%}{%- endif -%}
  {%- if repo.owner | lower == config.github.username | lower and repo.visibility != "PRIVATE" -%}
    {%- set topics = [] -%}
    {%- set featured = "portfolio-featured" in repo.topics -%}
    {%- for topic in repo.topics -%}{%- if topic.startsWith("portfolio-") and topic != "portfolio-featured" -%}{%- set ignored = topics.push(topic) -%}{%- endif -%}{%- endfor -%}
    {%- set matches = [] -%}
    {%- for group in project_groups -%}{%- if group.topic in topics -%}{%- set ignored = matches.push(group) -%}{%- endif -%}{%- endfor -%}
    {%- if topics | length > 0 or featured -%}
      {%- if topics | length != 1 or matches | length != 1 -%}
        {%- set ignored = invalid_topics.push(repo.nameWithOwner) -%}
      {%- else -%}
        {%- set project = {
          name: repo.name,
          nameWithOwner: repo.nameWithOwner,
          url: "https://github.com/" + repo.nameWithOwner,
          description: description,
          primaryLanguage: repo.primaryLanguage,
          stars: repo.stars,
          pushedAt: repo.pushedAt or "",
          topic: topics[0],
          featured: featured
        } -%}
        {%- set ignored = catalog.push(project) -%}
      {%- endif -%}
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}
{%- set catalog = catalog | sort(true, false, "pushedAt") | sort(true, false, "stars") | sort(true, false, "featured") -%}
{%- for project in catalog -%}
  {%- for group in project_groups -%}
    {%- if project.topic == group.topic -%}
      {%- set ignored = group.projects.push(project) -%}
    {%- endif -%}
  {%- endfor -%}
{%- endfor -%}
{%- set populated_groups = [] -%}
{%- for group in project_groups -%}{%- if group.projects | length > 0 -%}{%- set ignored = populated_groups.push(group) -%}{%- endif -%}{%- endfor -%}
