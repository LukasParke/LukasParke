{%- macro card(id, description, width) -%}
<picture>
  <source media="(prefers-reduced-motion: reduce)" srcset="{{ config.assets.baseUrl }}/{{ id }}.png" type="image/png">
  <source srcset="{{ profile_asset(id, config.assets) }}" type="image/webp">
  <img src="{{ profile_asset(id, {baseUrl: config.assets.baseUrl, format: 'gif'}) }}" width="{{ width }}" alt="{{ description }}">
</picture>
{%- endmacro -%}
{%- macro project_table(items) -%}
| Project | Language | Stars / last push |
| --- | --- | --- |
{% for project in items -%}
| <!-- project: {{ project.nameWithOwner }} -->[**{{ project.name | escape }}**]({{ project.url }})<br>{{ project.description | replace("\n", " ") | replace("\r", " ") | truncate(150) | escape | replace("|", "&#124;") }} | {{ project.primaryLanguage or "—" }} | ★ {{ project.stars }}<br>{% if project.pushedAt %}{{ project.pushedAt.slice(0, 10) }}{% else %}—{% endif %} |
{% endfor -%}
{%- endmacro -%}
{%- set posts = devto_posts("lukeparke", 5) -%}
{%- set community = fetch_json("https://api.github.com/users/LukasParke/followers?per_page=100").slice(-20) | reverse -%}
{%- set project_snapshot = fetch_json("https://raw.githubusercontent.com/LukasParke/stats/main/github-user-stats.json") -%}
{%- set description_overrides = {
  diffler: "GitHub statistics, profile READMEs, and animated cards—the tooling behind this profile."
} -%}
{%- set project_groups = [
  {id: "api", title: "API design & schemas", priority: 4, keywords: ["openapi", "oas", "schema", "language server", "lsp", "volar", "api spec", "websocket"], projects: []},
  {id: "agents", title: "AI & coding agents", priority: 1, keywords: ["coding agent", "coding-agent", "mcp", "qwen", "llm", "whiteboard"], projects: []},
  {id: "svelte", title: "Svelte & web apps", priority: 2, keywords: ["svelte", "personal site", "homepage"], projects: []},
  {id: "media", title: "Plex, media & devices", priority: 0, keywords: ["plex", "yoto", "wave3", "wave:3", "cec api", "terminal music"], projects: []},
  {id: "sdks", title: "SDKs & integrations", priority: 3, keywords: ["sdk", "integration", "oauth"], projects: []},
  {id: "workflow", title: "GitHub & developer workflows", priority: 5, keywords: ["github action", "github profile", "readme", "diffler", "default app", "pypi", "download analytics", "dead links"], projects: []},
  {id: "data", title: "Data & homelab", priority: 6, keywords: ["nethys", "docker", "homelab", "pocketbase", "selfhost", "linux", "coolify", "dokploy"], projects: []},
  {id: "reference", title: "Other tools & references", priority: 7, keywords: [], projects: []}
] -%}
{%- set catalog = [] -%}
{%- set candidates = project_snapshot.repositories | rejectattr("isPrivate") | rejectattr("isFork") | rejectattr("isArchived") -%}
{%- for repo in candidates -%}
  {%- set name = repo.name | lower -%}
  {%- set description = (repo.description or "") | trim -%}
  {%- if not description -%}{%- set description = description_overrides[name] or "" -%}{%- endif -%}
  {%- if repo.owner | lower == config.github.username | lower and repo.visibility != "PRIVATE" and description | trim and not name.startsWith(".") and not name.endsWith("-test") and not name.endsWith("-demo") and "-repro" not in name and name != "peon-hello-world" -%}
    {%- set project = {
      name: repo.name,
      nameWithOwner: repo.nameWithOwner,
      url: "https://github.com/" + repo.nameWithOwner,
      description: description,
      primaryLanguage: repo.primaryLanguage,
      stars: repo.stars,
      pushedAt: repo.pushedAt or "",
      search: (repo.name + " " + description + " " + (repo.topics | join(" "))) | lower
    } -%}
    {%- set ignored = catalog.push(project) -%}
  {%- endif -%}
{%- endfor -%}
{%- set catalog = catalog | sort(true, false, "pushedAt") | sort(true, false, "stars") -%}
{%- set assigned = [] -%}
{%- for project in catalog -%}
  {%- for group in project_groups | sort(false, false, "priority") -%}
    {%- set matches = [] -%}
    {%- for keyword in group.keywords -%}
      {%- if keyword in project.search -%}{%- set ignored = matches.push(keyword) -%}{%- endif -%}
    {%- endfor -%}
    {%- if project.nameWithOwner not in assigned and (matches | length > 0 or group.id == "reference") -%}
      {%- if project.name | lower == "diffler" -%}
        {%- set ignored = group.projects.unshift(project) -%}
      {%- else -%}
        {%- set ignored = group.projects.push(project) -%}
      {%- endif -%}
      {%- set ignored = assigned.push(project.nameWithOwner) -%}
    {%- endif -%}
  {%- endfor -%}
{%- endfor -%}
{%- set populated_groups = [] -%}
{%- for group in project_groups -%}{%- if group.projects | length > 0 -%}{%- set ignored = populated_groups.push(group) -%}{%- endif -%}{%- endfor -%}
