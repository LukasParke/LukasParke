  hive: "Self-hosted Docker Swarm PaaS with a Go control plane, builds, and per-node agents.",
  "home-ops": "Talos/Flux Kubernetes homelab GitOps, application manifests, and operational runbooks.",
  "jsdoc-cheatsheet": "Interactive reference for JSDoc tags, syntax, and examples.",
  navigator: "Go library for parsing, indexing, and resolving references across OpenAPI workspaces.",
  "omarchy-dream-theme": "Installable Omarchy theme for terminals, editors, GTK apps, and the compositor.",
  "paperclip-coolify": "Coolify deployment and image packaging for Paperclip, with agent CLIs and update automation.",
  "prowlarr-ts-sdk": "TypeScript Prowlarr client with an optional MCP server interface.",
  relay: "Local-first webhook/WebSocket capture, inspection, and signed-replay workbench.",
  rivet: "Self-hosted media discovery, acquisition, verification, and import orchestration.",
  smelt: "Rust model-format and inference-engine experiments, with measurement results.",
  suspect: "API engineering toolkit for OpenAPI, Arazzo, Overlay, validation, linting, LSP, and contract testing.",
  "tree-sitter-openapi": "OpenAPI-aware YAML and JSON Tree-sitter grammars, fragments, and Markdown injections.",
