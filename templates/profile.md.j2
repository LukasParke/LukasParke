{%- macro card(id, description, width) -%}
<picture>
  <source media="(prefers-reduced-motion: reduce)" srcset="{{ config.assets.baseUrl }}/{{ id }}.png" type="image/png">
  <source srcset="{{ profile_asset(id, config.assets) }}" type="image/webp">
  <img src="{{ profile_asset(id, {baseUrl: config.assets.baseUrl, format: 'gif'}) }}" width="{{ width }}" alt="{{ description }}">
</picture>
{%- endmacro -%}
{%- macro project_table(items) -%}
| Project | Language | Stars / last push |
| --- | --- | --- |
{% for project in items -%}
| <!-- project: {{ project.nameWithOwner }} -->[**{{ project.name | escape }}**]({{ project.url }}){% if project.description %}<br>{{ project.description | replace("\n", " ") | replace("\r", " ") | truncate(150) | escape | replace("|", "&#124;") }}{% endif %} | {{ project.primaryLanguage or "—" }} | ★ {{ project.stars }}<br>{% if project.pushedAt %}{{ project.pushedAt.slice(0, 10) }}{% else %}—{% endif %} |
{% endfor -%}
{%- endmacro -%}
{%- set posts = devto_posts("lukeparke", 5) -%}
