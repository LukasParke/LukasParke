{%- set project_snapshot = fetch_json("https://raw.githubusercontent.com/LukasParke/stats/main/github-user-stats.json") -%}
{%- set description_overrides = {
  diffler: "GitHub statistics, profile READMEs, and animated cards—the tooling behind this profile.",
